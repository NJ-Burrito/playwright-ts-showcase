{
  "name": "playwright-ts-showcase",
  "version": "1.0.0",
  "description": "Playwright + TypeScript demo: UI tests (Page Object Model, fixtures, storageState) and API tests against public practice sites.",
  "author": "Nader Alzghoul",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
